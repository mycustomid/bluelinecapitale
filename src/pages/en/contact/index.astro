---
import SiteLayout from "../../../layouts/SiteLayout.astro";
---
<SiteLayout title={"Contact — Blue Line Capital Group"} description={"Tell us what you are exploring. We will help direct your enquiry to the relevant team."} lang="en">
<section class="page-hero"><div class="shell page-hero-content"><div class="eyebrow"><span class="hairline"></span>01 / CONTACT / CONTACT</div><h1>Every good partnership begins with a conversation.</h1><p>Tell us what you are exploring. We will help direct your enquiry to the relevant team.</p></div><div aria-hidden="true" class="page-art"><img alt="" src="/assets/img/group-strategy.webp"/></div></section><section class="section shell contact-grid"><aside><span class="small-label">Corporate email</span><a class="contact-email" href="mailto:contact@bluelinecapitale.com">contact@bluelinecapitale.com &nearrow;</a><button class="copy-btn" data-copy="contact@bluelinecapitale.com" type="button">Copy email &nearrow;</button><div class="contact-location"><span class="small-label">Location</span><p>Douala, Cameroon</p></div><p class="small-muted">Submitting opens your email application. This website does not silently collect or send personal data.</p></aside><form action="mailto:contact@bluelinecapitale.com" class="contact-form" enctype="text/plain" id="contact-form" method="post"><div class="form-two"><label>Full name<input autocomplete="name" minlength="2" name="name" placeholder="Jane Doe" required="" type="text"/></label><label>Your email address<input autocomplete="email" name="email" placeholder="you@company.com" required="" type="email"/></label></div><label>Organisation (optional)<input autocomplete="organization" name="organization" placeholder="Organisation / Company"/></label><label>Nature of enquiry<select name="topic" required=""><option value="Partnership">Partnership</option><option value="Business enquiry">Business enquiry</option><option value="Media enquiry">Media enquiry</option><option value="Careers">Careers</option><option value="Other">Other</option></select></label><label>Tell us what you would like to discuss<textarea maxlength="5000" minlength="12" name="message" placeholder="..." required="" rows="6"></textarea></label><label class="consent"><input name="consent" required="" type="checkbox"/><span>I understand this will open my email application and has not yet been sent.</span></label><button class="btn btn-accent" type="submit">Open email to send enquiry &nearrow;</button><p aria-live="polite" class="form-status" id="form-status"></p></form></section>
</SiteLayout>
