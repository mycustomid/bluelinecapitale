interface Props { lang:'en'|'fr'; slug:string; }
const {lang,slug}=Astro.props;
const data = SECTORS.find((s)=>s.slug===slug);
const isFr=lang==='fr';
const title=isFr?'Un modèle opérationnel clair.':'An operating model with clarity.';
const intro=isFr?'Une lecture du parcours métier proposée pour cadrer le produit numérique. Cette représentation ne constitue ni une certification de conformité ni une référence de réalisation achevée.':'A proposed operational journey to align the digital product with its business domain. This diagram is not a compliance certification or a claim of completed delivery.';
const actions=isFr?['Découvrir les systèmes','Discuter du projet']:['Explore the systems','Discuss a project'];
const links=[`/${lang}/businesses/`,`/${lang}/contact/`];
---
{data && <section class="division-proof section" aria-label={isFr?'Modèle opérationnel':'Operating model'}>
<div class="shell division-proof-inner">
<div class="division-proof-intro"><div><span class="proof-code">{data.code} / 09 — {data.tag}</span><h2>{title}</h2></div><div><p>{intro}</p><div class="proof-actions"><a href={links[0]}>{actions[0]} <span aria-hidden="true">↗</span></a><a href={links[1]}>{actions[1]} <span aria-hidden="true">↗</span></a></div></div></div>
<div class="proof-workflow" role="list">{(isFr?data.frSteps:data.enSteps).map((step,index)=><article class="proof-step" role="listitem"><span class="proof-number">0{index+1}</span><h3>{step}</h3><span class="proof-progress" aria-hidden="true"></span></article>)}</div>
<div class="proof-note"><span class="proof-pulse" aria-hidden="true"></span><span>{isFr?'Cadre de conception · validation métier nécessaire avant la mise en production':'Design framework · business validation required before production'}</span><span class="proof-end">BLUE LINE / ENTERPRISE</span></div>
</div>
</section>}
