---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title:string; description:string; lang:'en'|'fr'; }
const {title,description,lang}=Astro.props;
const currentPath=Astro.url.pathname.endsWith('/')?Astro.url.pathname:Astro.url.pathname+'/';
const otherLang=lang==='en'?'fr':'en';
const otherPath=currentPath.replace(/^\/(en|fr)(?=\/)/,`/${otherLang}`);
const base='https://bluelinecapitale.com';
const canonical=new URL(currentPath,base).toString();
const alternate=new URL(otherPath,base).toString();
const enUrl=lang==='en'?canonical:alternate;
const schema={"@context":"https://schema.org","@type":"Organization",name:'Blue Line Capital Group',url:base,logo:base+'/assets/img/blue-line-logo.png',address:{"@type":"PostalAddress",addressLocality:'Douala',addressCountry:'CM'}};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0b2030" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonical}/>
  <link rel="alternate" hreflang={lang} href={canonical}/>
  <link rel="alternate" hreflang={otherLang} href={alternate}/>
  <link rel="alternate" hreflang="x-default" href={enUrl}/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={base+'/assets/img/social-cover.jpg'}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
  <link rel="preload" href="/assets/styles.css" as="style"/>
  <link rel="stylesheet" href="/assets/styles.css"/>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
</head>
<body>
  <SiteHeader lang={lang} currentPath={currentPath}/>
  <main id="main"><slot/></main>
  <SiteFooter lang={lang}/>
  <script is:inline defer src="/assets/site.js"></script>
</body>
</html>
